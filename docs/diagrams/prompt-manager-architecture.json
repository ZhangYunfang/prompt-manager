    {
      "dot": "cyan",
      "title": "界面与主题",
      "items": [
        "顶栏品牌行 + 流光强调线，中段三栏可拖拽分隔",
        "黑夜 #1a2236 / 白天双外观 × 12 色主体方格色板",
        "切色或切主题后全部线性图标按新主体色重绘"
      ]
    },
    {
      "dot": "emerald",
      "title": "编辑与 AI",
      "items": [
        "格式化清理与提示词优化都走流式输出，50ms 轮询回填",
        "停止输入 2 秒后预取标题与标签，省一次弹窗",
        "设置页可测连接；未配 Key 时按钮直接提示先配置"
      ]
    },
    {
      "dot": "violet",
      "title": "本地数据",
      "items": [
        "三个文件同住 ~/prompt-manager/，全部留在本机",
        "写盘走 tmp 再 replace，避免半截 JSON",
        "settings.json 含 API Key，写入后立即 chmod 0600"
      ]
    },
    {
      "dot": "amber",
      "title": "分发",
      "items": [
        "PyInstaller 单文件打包，run.sh / run.bat 免装启动",
        "发布物是 GitHub Release 上的 macOS arm64 zip"
      ]
    }
  ]
